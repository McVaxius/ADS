<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <EmbeddedResource Include="PoeticsGearOffers.json" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(DALAMUD_HOME)/cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" Condition="'$(DALAMUD_HOME)' != ''" />
    <None Include="$(appdata)\XIVLauncher\addon\Hooks\dev\cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" Condition="'$(DALAMUD_HOME)' == ''" />
    <ProjectReference Include="..\ADS\ADS.csproj" />
    <ProjectReference Include="..\..\FrenRider\FrenRider\FrenRider.csproj" />
    <Reference Include="Dalamud;Dalamud.Bindings.ImGui;Lumina;Lumina.Excel;FFXIVClientStructs;InteropGenerator.Runtime">
      <HintPath Condition="'$(DALAMUD_HOME)' == ''">$(appdata)\XIVLauncher\addon\Hooks\dev\%(Identity).dll</HintPath>
      <HintPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)/%(Identity).dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
